<Window x:Class="AgentForExcel.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agent for Excel 设置" Height="700" Width="960" MinHeight="650" MinWidth="880"
        WindowStartupLocation="CenterOwner" Background="#F5F7F4"
        ResizeMode="CanResize" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="36"/><Setter Property="Padding" Value="9,6"/>
            <Setter Property="FontSize" Value="12.5"/><Setter Property="BorderBrush" Value="#CCD6CF"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="36"/><Setter Property="Padding" Value="7,4"/>
            <Setter Property="FontSize" Value="12.5"/><Setter Property="BorderBrush" Value="#CCD6CF"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="36"/><Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Height" Value="31"/><Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="#F6F9F6"/><Setter Property="BorderBrush" Value="#D5DED8"/>
            <Setter Property="Foreground" Value="#315044"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="43"/><Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Padding" Value="13,0"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#33443B"/><Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavChrome" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavChrome" Property="Background" Value="#EDF3EE"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingCheck" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12.5"/><Setter Property="Foreground" Value="#273A31"/>
            <Setter Property="Margin" Value="0,0,0,8"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DEE5E0"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Background="#FBFCFA" BorderBrush="#DFE6E1" BorderThickness="1"
                                CornerRadius="10" Padding="10" Cursor="Hand">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#AFCDB9"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#EAF5EC"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="#7EB18F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Background="#FFFEFB" BorderBrush="#E0E6E1" BorderThickness="0,0,0,1" Padding="24,17">
            <Grid>
                <StackPanel>
                    <TextBlock Text="设置" FontSize="21" FontWeight="SemiBold" Foreground="#14251E"/>
                    <TextBlock Text="管理模型、执行规则、工作簿行为和本机数据。" FontSize="11.5" Foreground="#6A756F" Margin="0,5,0,0"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#EAF5EC" CornerRadius="10" Padding="10,6">
                    <TextBlock Text="本机安全保存" FontSize="10.5" Foreground="#18734A"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18,16,18,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="176"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="#FBFCFA" BorderBrush="#E0E6E1" BorderThickness="1" CornerRadius="13" Padding="9">
                <StackPanel>
                    <Button x:Name="ModelsNav" Content="模型与连接" Tag="models" Style="{StaticResource NavButton}" Click="Navigation_Click"/>
                    <Button x:Name="SafetyNav" Content="执行与安全" Tag="safety" Style="{StaticResource NavButton}" Click="Navigation_Click"/>
                    <Button x:Name="WorkbookNav" Content="工作簿行为" Tag="workbook" Style="{StaticResource NavButton}" Click="Navigation_Click"/>
                    <Button x:Name="PrivacyNav" Content="数据与隐私" Tag="privacy" Style="{StaticResource NavButton}" Click="Navigation_Click"/>
                    <Button x:Name="AppearanceNav" Content="外观" Tag="appearance" Style="{StaticResource NavButton}" Click="Navigation_Click"/>
                    <Button x:Name="DiagnosticsNav" Content="诊断与关于" Tag="diagnostics" Style="{StaticResource NavButton}" Click="Navigation_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="#FDFEFC" BorderBrush="#E0E6E1" BorderThickness="1" CornerRadius="14" Padding="19">
                <Grid>
                    <Grid x:Name="ModelsPanel">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Margin="1,0,0,14">
                            <TextBlock Text="模型与连接" FontSize="18" FontWeight="SemiBold" Foreground="#14251E"/>
                            <TextBlock Text="保存多个模型档案，并在聊天输入区随时切换。" FontSize="10.8" Foreground="#6A756F" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Background="White" BorderBrush="#E0E6E1" BorderThickness="1" CornerRadius="12" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="模型档案" FontSize="13" FontWeight="SemiBold" Foreground="#183128" Margin="2,0,0,10"/>
                                    <ListBox x:Name="ProfileList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                                             SelectionChanged="ProfileList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="12.5" FontWeight="SemiBold" Foreground="#21382F" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Summary}" FontSize="10" Foreground="#6F7B75" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Grid Grid.Row="2" Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="＋ 新增" Style="{StaticResource SmallButton}" Margin="0,0,4,0" Click="AddProfile_Click"/>
                                        <Button Grid.Column="1" Content="复制" Style="{StaticResource SmallButton}" Margin="2,0" Click="DuplicateProfile_Click"/>
                                        <Button Grid.Column="2" Content="删除" Style="{StaticResource SmallButton}" Margin="4,0,0,0" Click="DeleteProfile_Click"/>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Background="White" BorderBrush="#E0E6E1" BorderThickness="1" CornerRadius="12" Padding="17">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="档案名称" FontSize="11.5" Foreground="#47564F" Margin="0,0,0,5"/>
                                        <TextBox x:Name="DisplayNameBox" ToolTip="例如：GLM 日常分析、Claude 深度推理"/>
                                        <TextBlock Text="服务提供商" FontSize="11.5" Foreground="#47564F" Margin="0,12,0,5"/>
                                        <ComboBox x:Name="ProviderCombo" DisplayMemberPath="Name" SelectionChanged="ProviderCombo_SelectionChanged"/>
                                        <TextBlock Text="API Key" FontSize="11.5" Foreground="#47564F" Margin="0,12,0,5"/>
                                        <PasswordBox x:Name="ApiKeyBox" Height="36" FontSize="12.5" Padding="9,6" BorderBrush="#CCD6CF" Background="White" PasswordChar="●"/>
                                        <TextBlock Text="Base URL" FontSize="11.5" Foreground="#47564F" Margin="0,12,0,5"/>
                                        <TextBox x:Name="BaseUrlBox"/>
                                        <TextBlock Text="模型 ID" FontSize="11.5" Foreground="#47564F" Margin="0,12,0,5"/>
                                        <ComboBox x:Name="ModelCombo" IsEditable="True" IsTextSearchEnabled="True"/>
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="温度" FontSize="11.5" Foreground="#47564F" VerticalAlignment="Center"/>
                                            <Slider x:Name="TempSlider" Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="14,0"/>
                                            <TextBlock x:Name="TempValue" Grid.Column="2" FontSize="11.5" Foreground="#47564F" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>

                    <ScrollViewer x:Name="SafetyPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="执行与安全" FontSize="18" FontWeight="SemiBold" Foreground="#14251E"/>
                            <TextBlock Text="按风险和目标范围决定是否自动执行；危险操作始终保留人工确认。" FontSize="10.8" Foreground="#6A756F" Margin="0,4,0,15"/>
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="自动化权限" FontSize="13.5" FontWeight="SemiBold" Foreground="#183128"/>
                                    <TextBlock Text="“自动执行”免确认运行常规读写；”安全自动化“仅自动执行新工作表输出与锁定选区内的空白写入/格式化。" FontSize="10.5" Foreground="#68766F" TextWrapping="Wrap" Margin="0,4,0,9"/>
                                    <ComboBox x:Name="AutomationModeCombo" Width="300" HorizontalAlignment="Left" SelectedValuePath="Tag">
                                        <ComboBoxItem Content="自动执行（危险操作仍确认）" Tag="auto"/>
                                        <ComboBoxItem Content="安全自动化（推荐）" Tag="safe_auto"/>
                                        <ComboBoxItem Content="每次写入都询问" Tag="ask_every_time"/>
                                        <ComboBoxItem Content="自定义规则" Tag="custom"/>
                                    </ComboBox>
                                    <CheckBox x:Name="AutoNewSheetCheck" Content="自动允许输出到新工作表" Style="{StaticResource SettingCheck}" Margin="0,12,0,0"/>
                                    <CheckBox x:Name="AutoSelectedWritesCheck" Content="自动允许锁定选区内的空白写值和公式" Style="{StaticResource SettingCheck}"/>
                                    <CheckBox x:Name="AutoFormatCheck" Content="自动允许锁定选区内的格式化" Style="{StaticResource SettingCheck}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="单次自动写入上限" FontSize="10.8" Foreground="#47564F" VerticalAlignment="Center"/>
                                        <TextBox x:Name="AutoWriteLimitBox" Width="84" Margin="10,0,6,0" Padding="7,4"/>
                                        <TextBlock Text="个单元格" FontSize="10.8" Foreground="#68766F" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="无论哪种模式，VBA、刷新查询/模型、Power Pivot 关系与 DAX、覆盖 Power Query 查询定义仍会询问；其他写操作是否询问取决于所选模式。" FontSize="10.5" Foreground="#9A5B2D" TextWrapping="Wrap" Margin="0,9,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="专业能力" FontSize="13.5" FontWeight="SemiBold" Foreground="#183128" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="EnablePowerQueryCheck" Content="允许 Power Query 清洗、加载与刷新" Style="{StaticResource SettingCheck}"/>
                                    <CheckBox x:Name="EnablePowerPivotCheck" Content="允许 Power Pivot、关系和 DAX 操作" Style="{StaticResource SettingCheck}"/>
                                    <CheckBox x:Name="EnableVbaCheck" Content="允许受控 VBA 白名单配方" Style="{StaticResource SettingCheck}"/>
                                    <TextBlock Text="VBA 始终要求先预览再执行，不接受任意代码注入。" FontSize="10.5" Foreground="#68766F" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="WorkbookPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="工作簿行为" FontSize="18" FontWeight="SemiBold" Foreground="#14251E"/>
                            <TextBlock Text="决定 Agent 默认在哪里分析和输出，减少误改原始数据。" FontSize="10.8" Foreground="#6A756F" Margin="0,4,0,15"/>
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="默认输出策略" FontSize="13.5" FontWeight="SemiBold" Foreground="#183128" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="PreserveSourceCheck" Content="默认保护原始工作表，不直接重排或覆盖源数据" Style="{StaticResource SettingCheck}"/>
                                    <CheckBox x:Name="NewSheetCheck" Content="排序、清洗、图表、透视表和看板优先输出到新工作表" Style="{StaticResource SettingCheck}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="默认分析范围" FontSize="13.5" FontWeight="SemiBold" Foreground="#183128"/>
                                    <TextBlock Text="当用户没有明确指定区域时使用；Agent 仍会先确认标题和数据粒度。" FontSize="10.5" Foreground="#68766F" Margin="0,4,0,9"/>
                                    <ComboBox x:Name="DefaultScopeCombo" Width="250" HorizontalAlignment="Left" SelectedValuePath="Tag">
                                        <ComboBoxItem Content="当前数据区域（推荐）" Tag="CurrentRegion"/>
                                        <ComboBoxItem Content="当前选区" Tag="Selection"/>
                                        <ComboBoxItem Content="工作表已用区域" Tag="UsedRange"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="PrivacyPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="数据与隐私" FontSize="18" FontWeight="SemiBold" Foreground="#14251E"/>
                            <TextBlock Text="管理本机聊天记录和模型连接信息。" FontSize="10.8" Foreground="#6A756F" Margin="0,4,0,15"/>
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="聊天记录" FontSize="13.5" FontWeight="SemiBold" Foreground="#183128" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="SaveHistoryCheck" Content="在本机保存聊天记录" Style="{StaticResource SettingCheck}"/>
                                    <TextBlock Text="关闭后新消息只保留在当前 Excel 会话中；已有记录不会自动删除。" FontSize="10.5" Foreground="#68766F" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="本机存储" FontSize="13.5" FontWeight="SemiBold" Foreground="#183128"/>
                                    <TextBlock x:Name="StoragePathText" FontSize="10.5" Foreground="#68766F" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                    <TextBlock Text="API Key 和聊天记录不会写入 Excel 工作簿。请不要共享本机设置文件。" FontSize="10.5" Foreground="#68766F" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="AppearancePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="外观" FontSize="18" FontWeight="SemiBold" Foreground="#14251E"/>
                            <TextBlock Text="当前版本使用统一的报告级浅色设计。" FontSize="10.8" Foreground="#6A756F" Margin="0,4,0,15"/>
                            <Border Style="{StaticResource SectionCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="温和浅色" FontSize="13.5" FontWeight="SemiBold" Foreground="#183128"/>
                                        <TextBlock Text="暖白背景、雾绿色状态和低对比边框，适合长时间分析。" FontSize="10.5" Foreground="#68766F" Margin="0,5,20,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#EAF5EC" CornerRadius="9" Padding="10,5" VerticalAlignment="Top">
                                        <TextBlock Text="正在使用" FontSize="10.5" Foreground="#17734A"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock Text="深色主题将在完成现有核心流程后加入，当前不提供无效开关。" FontSize="10.5" Foreground="#7A837E"/>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="DiagnosticsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="诊断与关于" FontSize="18" FontWeight="SemiBold" Foreground="#14251E"/>
                            <TextBlock Text="检查 Excel、Power Query、Power Pivot、VBA 和工具注册状态。" FontSize="10.8" Foreground="#6A756F" Margin="0,4,0,15"/>
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Agent 环境自检" FontSize="13.5" FontWeight="SemiBold" Foreground="#183128"/>
                                            <TextBlock Text="直接执行只读诊断，不修改工作簿。" FontSize="10.5" Foreground="#68766F" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="运行自检" Style="{StaticResource SmallButton}" Click="RunDiagnostics_Click"/>
                                    </Grid>
                                    <TextBlock x:Name="DiagnosticsResult" FontSize="10.5" Foreground="#405248" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="Agent for Excel" FontSize="13.5" FontWeight="SemiBold" Foreground="#183128"/>
                                    <TextBlock x:Name="EditionStatus" FontSize="10.5" Foreground="#405248" TextWrapping="Wrap" Margin="0,5,0,10"/>
                                    <TextBlock x:Name="VersionStatus" FontSize="10.5" Foreground="#68766F" Margin="0,5,0,10"/>
                                    <Button Content="打开本机日志目录" Style="{StaticResource SmallButton}" HorizontalAlignment="Left" Click="OpenLogFolder_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#FFFEFB" BorderBrush="#E0E6E1" BorderThickness="0,1,0,0" Padding="20,13">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource ActionButton}" Margin="0,0,9,0" Background="White" BorderBrush="#C9D3CC" Foreground="#304039" Click="Cancel_Click"/>
                <Button Content="保存设置" Style="{StaticResource ActionButton}" Background="#17764A" BorderBrush="#17764A" Foreground="White" Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
